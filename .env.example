# Firebase web configuration is public client configuration, not an Admin credential.
# Copy to .env.local. Fill API_KEY with the Firebase console value. Restart Vite after changing it.
VITE_FIREBASE_ENABLED=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=delivery-28165.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=delivery-28165
VITE_FIREBASE_STORAGE_BUCKET=delivery-28165.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=706574701792
VITE_FIREBASE_APP_ID=1:706574701792:web:37d8039c81842a5b206c85

# Optional Phase 2 identity bridge. Public CISapp web configuration, never a service account.
VITE_CISAPP_FIREBASE_CONFIG=
# Default bridge is fixed to CISapp; development loopback emulator URLs are also accepted.
VITE_DISPATCH_BRIDGE_URL=https://asia-south1-cisapp-236ab.cloudfunctions.net/dispatchBridge

# Optional CISapp URL for links; no credentials here.
VITE_CISAPP_URL=https://cisapp-236ab.web.app
